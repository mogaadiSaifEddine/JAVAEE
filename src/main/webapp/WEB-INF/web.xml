<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Restaurant Management System</display-name>
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <el-ignored>false</el-ignored>
            <scripting-invalid>false</scripting-invalid>
        </jsp-property-group>
    </jsp-config>
    <servlet>
        <servlet-name>ClientServlet</servlet-name>
        <servlet-class>controllers.ClientServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ClientServlet</servlet-name>
        <url-pattern>/clients/*</url-pattern>
    </servlet-mapping>
    <servlet>
    <servlet-name>MenuServlet</servlet-name>
    <servlet-class>controllers.MenuServlet</servlet-class>
</servlet>
    <servlet-mapping>
        <servlet-name>MenuServlet</servlet-name>
        <url-pattern>/menus/*</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>CommandeServlet</servlet-name>
        <servlet-class>controllers.CommandeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CommandeServlet</servlet-name>
        <url-pattern>/commandes/*</url-pattern>
    </servlet-mapping>
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- You can add more configurations here as needed -->

</web-app>